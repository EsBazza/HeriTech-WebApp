rules_version = '2';

// The browser never reads or writes Firestore directly. Every request goes
// through the Next.js API routes, which use the Admin SDK (it bypasses these
// rules) and check the caller's Firebase ID token and role. Denying all client
// access means a leaked web API key cannot be used to read or change data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
