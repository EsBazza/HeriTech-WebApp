# Copy to .env and fill in. Never commit .env.

# Firebase web app (Firebase console → Project settings → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin: the service account JSON file, pasted as a single line (server only)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Signs the QR codes artisans show at pickup. Any random string of 32+ characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
HANDOVER_TOKEN_SECRET=

# Public URL of this deployment, used in impact pass QR codes
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Wallet (Pay & Wallet console → Google Wallet API). The service account must be
# added under "Users" in the Wallet console. Leave the email/key empty to reuse the
# Firebase service account above.
GOOGLE_WALLET_ISSUER_ID=
# The class id you created in the console, without the issuer prefix (default: heritech_impact_pass)
GOOGLE_WALLET_CLASS_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=

# Google Maps JavaScript API key (restrict it to your domains in Google Cloud Console)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# AI and translation
GEMINI_API_KEY=
# Optional: comma-separated models to try in order (default: gemini-3.5-flash-lite,gemini-3.6-flash)
GEMINI_MODELS=
# Optional: falls back to Gemini when unset
GOOGLE_TRANSLATE_API_KEY=

# Shown on /privacy and /delete-account as the address for data questions (required for Google Play).
# Optional: defaults to the team address in src/lib/contact.ts
NEXT_PUBLIC_CONTACT_EMAIL=

# Google Play app (Trusted Web Activity): served at /.well-known/assetlinks.json
# The package name, and the SHA-256 fingerprints (comma-separated) of the Play app signing key and the upload key
ANDROID_PACKAGE_NAME=
ANDROID_CERT_SHA256=

# "true" only on the presentation deployment (adds one-click demo accounts)
NEXT_PUBLIC_DEMO_MODE=false

# Local development against the emulators only (see README "Testing")
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
